<?xml version="1.0" encoding="utf-8"?>
<!--
    AutoMinder · Notification Small Icon
    System tray / status bar. Android renders this icon in SINGLE COLOUR
    (white by default, overlaid on notification background). All paths must be
    transparent background + solid filled or stroked shapes.

    Composition: simplified front-facing car outline + clock badge top-right.
    Sized 24×24dp viewport for status bar rendering.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Car front outline silhouette -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
          M 12,6.5
          C 8.5,6.5 5.5,7.5 3.5,9
          L 2.5,9
          C 2,9 1.5,9.5 1.5,10
          L 1.5,11
          C 1.5,11.5 2,12 2.5,12
          L 2.8,12
          C 2.8,12.5 2.5,13 2.5,13.5
          L 2.5,16
          C 2.5,16.5 3,17 3.5,17
          L 4.5,17
          L 4.5,17.5
          C 4.5,18.3 5.2,19 6,19
          C 6.8,19 7.5,18.3 7.5,17.5
          L 7.5,17
          L 16.5,17
          L 16.5,17.5
          C 16.5,18.3 17.2,19 18,19
          C 18.8,19 19.5,18.3 19.5,17.5
          L 19.5,17
          L 20.5,17
          C 21,17 21.5,16.5 21.5,16
          L 21.5,13.5
          C 21.5,13 21.2,12.5 21.2,12
          L 21.5,12
          C 22,12 22.5,11.5 22.5,11
          L 22.5,10
          C 22.5,9.5 22,9 21.5,9
          L 20.5,9
          C 18.5,7.5 15.5,6.5 12,6.5 Z" />

    <!-- Windshield cutout -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#00000000"
        android:pathData="
          M 12,8
          C 9,8 6.5,9 5.5,10
          L 5.5,12.5
          L 18.5,12.5
          L 18.5,10
          C 17.5,9 15,8 12,8 Z" />

    <!-- Windshield (transparent — shows as outline only via car body shape) -->

    <!-- Left wheel -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 6,15.8 A 2,2 0 1 1 5.999,15.8 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#00000000"
        android:pathData="M 6,15.8 A 1,1 0 1 1 5.999,15.8 Z" />

    <!-- Right wheel -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 18,15.8 A 2,2 0 1 1 17.999,15.8 Z" />

    <!-- Clock badge (top-right corner, 5dp radius) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 20,1 A 4,4 0 1 1 19.999,1 Z" />
    <!-- Clock ring cutout -->
    <path
        android:fillColor="#00000000"
        android:pathData="M 20,2 A 2.8,2.8 0 1 1 19.999,2 Z" />
    <!-- Clock hour hand -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="0.7"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 20,5 L 18.5,3.8" />
    <!-- Clock minute hand -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="0.7"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 20,5 L 20,2.5" />

</vector>
