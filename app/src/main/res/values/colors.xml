<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Splash screen icon circle background (the disc behind the icon graphic).
         Cobalt primary: makes the white car+clock pop on both light and dark
         splash backgrounds. -->
    <color name="splash_icon_background">#0B4FC4</color>

    <!-- Splash ground, light theme. Night Garage light ground
         (docs/DESIGN_SYSTEM_2026.md §2); values-night carries the dark one.
         This was #004D40 — Material Teal 900, from the brand Night Garage
         replaced — so every cold start flashed teal before Compose drew. A
         window theme cannot read MaterialTheme.colorScheme, so this has to be
         a literal; it was simply missed in the rebrand. -->
    <color name="splash_background">#F7F9FC</color>
</resources>
