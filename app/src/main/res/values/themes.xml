<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme for a Compose-only app — no action bar, no XML layouts -->
    <style name="Theme.AutoMinder" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash screen theme (androidx.core:core-splashscreen) -->
    <style name="Theme.AutoMinder.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="postSplashScreenTheme">@style/Theme.AutoMinder</item>
    </style>
</resources>
