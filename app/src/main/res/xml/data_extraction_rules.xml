<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup + device-to-device transfer config.
     User records (Room DB, DataStore) must survive phone upgrades —
     data loss is the #1 churn driver in this category. No secrets are
     stored locally, so nothing needs excluding. -->
<data-extraction-rules>
    <!-- The -wal/-shm exclusions pair with AutoMinderBackupAgent, which
         checkpoints the write-ahead log into autominder.db before either of
         these passes copies anything. See backup_rules.xml for the reasoning. -->
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
        <exclude domain="database" path="autominder.db-wal" />
        <exclude domain="database" path="autominder.db-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
        <exclude domain="database" path="autominder.db-wal" />
        <exclude domain="database" path="autominder.db-shm" />
    </device-transfer>
</data-extraction-rules>
