<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only permissions the app actually uses. Photo attachments go through
         the system photo picker, which needs no media/camera permission.
         Reminders run on WorkManager, which needs no exact-alarm permission. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Android 11+ package visibility: allow resolving ACTION_SEND for CSV/text sharing -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/csv" />
        </intent>
    </queries>

    <application
        android:name=".AutoMinderApp"
        android:allowBackup="true"
        android:backupAgent=".data.backup.AutoMinderBackupAgent"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutoMinder"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33">

        <!-- AdMob App ID — injected at build time via resValue in build.gradle.kts -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id" />

        <!-- WorkManager: manual init (required when HiltWorkerFactory is used) -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AutoMinder.Splash"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Handles Done/Snooze taps from reminder notifications -->
        <receiver
            android:name=".core.notifications.NotificationActionReceiver"
            android:exported="false" />

        <!-- Re-arms background scheduling after events that clear it. BOOT and
             MY_PACKAGE_REPLACED are delivered only by the system; TIME_SET and
             TIMEZONE_CHANGED are protected broadcasts, so no app can forge them.
             android:permission still gates the boot action specifically. -->
        <receiver
            android:name=".worker.SystemEventReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Daily inexact backstop under the 6-hour WorkManager schedule.
             Not exported: the only sender is this app's own PendingIntent,
             delivered by AlarmManager to an explicit component. -->
        <receiver
            android:name=".worker.ReminderAlarmReceiver"
            android:exported="false" />

        <!-- FileProvider for sharing exported CSV files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Home screen widget -->
        <receiver
            android:name=".widget.AutoMinderWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/auto_minder_widget_info" />
        </receiver>

    
    <!-- Required: set your sentry.io project identifier (DSN) -->
    <meta-data android:name="io.sentry.dsn" android:value="https://1ac1c7fa90c9dbbc272af2b65c1babc6@o4511965329948672.ingest.us.sentry.io/4511965334732800" />

    <!-- enable automatic breadcrumbs for user interactions (clicks, swipes, scrolls) -->
    <meta-data android:name="io.sentry.traces.user-interaction.enable" android:value="true" />
    <!-- Screenshot attachment disabled: AutoMinder screens can show VINs, plates,
         and location data, which this app's privacy rules forbid sending to a
         third-party SaaS (see CLAUDE.md SECURITY & PRIVACY LAW). -->
    <meta-data android:name="io.sentry.attach-screenshot" android:value="false" />
    <!-- enable view hierarchy for crashes -->
    <meta-data android:name="io.sentry.attach-view-hierarchy" android:value="true" />

    <!-- enable the performance API by setting a sample-rate, adjust in production env -->
    <meta-data android:name="io.sentry.traces.sample-rate" android:value="1.0" />
</application>

</manifest>
